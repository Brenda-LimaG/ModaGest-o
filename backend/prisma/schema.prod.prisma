generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marca {
  id           String    @id @default(uuid())
  nome         String    @unique
  descricao    String?
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  telefone     String?
  instagram    String?
  logoUrl      String?   @map("logo_url")
  ativa        Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  produtos Produto[]
  tecidos  Tecido[]

  @@map("marcas")
}

model Produto {
  id             String   @id @default(uuid())
  marcaId        String   @map("marca_id")
  nome           String
  descricao      String?
  fotosJson      String   @default("[]") @map("fotos_json")
  precoVenda     Float?   @map("preco_venda")
  publicado      Boolean  @default(false)
  custoTecidos   Float    @default(0) @map("custo_tecidos")
  outrosCustos   Float    @default(0) @map("outros_custos")
  custoTotal     Float    @default(0) @map("custo_total")
  margemLucroPct Float?   @map("margem_lucro_pct")
  precoSugerido  Float?   @map("preco_sugerido")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  marca         Marca           @relation(fields: [marcaId], references: [id])
  tecidosUsados ProdutoTecido[]

  @@map("produtos")
}

model Tecido {
  id                String   @id @default(uuid())
  marcaId           String   @map("marca_id")
  nome              String
  tipo              String?
  cor               String?
  textura           String?
  fotoUrl           String?  @map("foto_url")
  quantidadeEstoque Float    @default(0) @map("quantidade_estoque")
  unidadeMedida     String   @default("metro") @map("unidade_medida")
  valorPorUnidade   Float    @map("valor_por_unidade")
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  marca    Marca           @relation(fields: [marcaId], references: [id])
  produtos ProdutoTecido[]

  @@map("tecidos")
}

model ProdutoTecido {
  id             String  @id @default(uuid())
  produtoId      String  @map("produto_id")
  tecidoId       String  @map("tecido_id")
  quantidade     Float
  custoCalculado Float   @map("custo_calculado")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tecido  Tecido  @relation(fields: [tecidoId], references: [id])

  @@map("produto_tecidos")
}
